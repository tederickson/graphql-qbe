input AuthorInput {
  firstName: String
  lastName: String
  email: String
  username: String
}

type AuthorEntity {
  authorId: ID!

  firstName: String!
  lastName: String!
  email: String!
  username: String!

  posts: [PostEntity]
}

type PostEntity {
  postId: ID!

  title: String!
  content: String!
  publishedOn: String!

  author: AuthorEntity!
  comments: [CommentEntity]
}

type CommentEntity {
  commentId: ID!

  name: String!
  content: String!
  publishedOn: String!
  updatedOn: String

  post: PostEntity!
}

type Query {
    authorById(authorId: ID!): AuthorEntity
    allAuthors: [AuthorEntity]!
    authors(authorInput: AuthorInput!): [AuthorEntity]!

    postById(postId: ID!): PostEntity
}
